{
  "name": "maotu",
  "version": "0.3.1",
  "private": false,
  "scripts": {
    "dev": "pnpm run format && vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "vite:serve": "vite",
    "electron:start": "VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "electron:dev": "concurrently -k -n vite,electron -c blue,green \"pnpm run vite:serve\" \"pnpm run electron:start\"",
    "electron:preview": "pnpm run build-only && electron electron/main.cjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:build": "pnpm run build-only && pnpm run electron:rebuild && electron-builder",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "lib": "vite build --mode lib",
    "npm": "vite build --mode npm"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/maotu.umd.js",
  "module": "./dist/maotu.es.js",
  "exports": {
    ".": {
      "import": "./dist/maotu.es.js",
      "require": "./dist/maotu.umd.js",
      "types": "./dist/src/export.d.ts"
    },
    "./*": "./*"
  },
  "typings": "dist/export.d.ts",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "vue-demi",
      "vue-echarts"
    ]
  },
  "build": {
    "appId": "com.maotu.app",
    "productName": "一次接线图",
    "copyright": "Copyright © 2026 maotu",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^10.6.1",
    "ace-builds": "^1.32.0",
    "animate.css": "^4.1.1",
    "better-sqlite3": "^12.11.1",
    "canvg": "^4.0.1",
    "echarts": "^5.4.3",
    "element-plus": "^2.4.2",
    "html2canvas": "^1.4.1",
    "less": "^4.2.0",
    "sql.js": "^1.14.1",
    "vue": "^3.3.4",
    "vue-echarts": "^6.6.5",
    "vue-router": "^4.2.5",
    "vue3-ace-editor": "^2.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/jsdom": "^21.1.3",
    "@types/node": "^18.18.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.1",
    "@vue/tsconfig": "^0.4.0",
    "code-inspector-plugin": "^1.6.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^22.1.0",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "typescript": "~5.2.0",
    "unocss": "^0.57.4",
    "vite": "^4.4.11",
    "vite-plugin-dts": "^3.6.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.19"
  }
}
